# GrapeLabs Website Bot Environment Configuration
PORT=3000
NODE_ENV=development
AUTO_OPEN_CONTROL_PANEL=true

# OpenAI GPT model fallback. The API key is saved in Firebase from the control panel.
OPENAI_MODEL=gpt-4o-mini

# Firebase Admin SDK credentials (store as deployment environment variables)
FIREBASE_PROJECT_ID=aichatbot-9bbc3
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# n8n calls POST /api/chat using this shared secret. Keep channel credentials in n8n.
N8N_API_KEY=

# Alerts & Automation
N8N_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890

# Token Secret for HMAC Link Signing (?gl=...)
TOKEN_SECRET=grapelabs-secret-key-31-oct-2026
